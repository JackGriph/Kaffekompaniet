@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Event>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
	var root = Model.Root();
	var siteName = root.Value<string>("siteName");
	if (string.IsNullOrWhiteSpace(siteName))
	{
		siteName = root.Name;
	}
	var rubrik = string.IsNullOrWhiteSpace(Model.Rubrik) ? Model.Name : Model.Rubrik;
	var sidtitel = string.IsNullOrWhiteSpace(Model.SeoTitle) ? Model.Name : Model.SeoTitle;
	var sv = new System.Globalization.CultureInfo("sv-SE");
	var anmalan = Model.Anmalningslank?.FirstOrDefault();
}

@section Head {
	<title>@sidtitel | @siteName</title>
	@if (!string.IsNullOrWhiteSpace(Model.MetaDescription))
	{
		<meta name="description" content="@Model.MetaDescription">
	}
}

<article class="event">
	<h1>@rubrik</h1>

	<p class="event__tid">
		<time datetime="@Model.Starttid.ToString("yyyy-MM-ddTHH:mm")">
			@Model.Starttid.ToString("d MMMM yyyy 'kl.' HH:mm", sv)
		</time>
	</p>

	@if (!string.IsNullOrWhiteSpace(Model.Plats))
	{
		<p class="event__plats">Plats: @Model.Plats</p>
	}

	@if (Model.Bild != null)
	{
		<img src="@Model.Bild.Url()" alt="@Model.BildAltText" />
	}

	@Model.Beskrivning

	@if (anmalan != null)
	{
		<p><a href="@anmalan.Url" target="@anmalan.Target">Anmäl dig</a></p>
	}
</article>