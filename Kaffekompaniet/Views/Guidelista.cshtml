@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Guidelista>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
	var guider = Model.Children().Where(x => x.IsVisible()).OfType<Bryggguide>().ToList();
}

<h1>@Model.Name</h1>
@Model.Brodtext

@if (guider.Any())
{
	<ul class="kort">
		@foreach (var guide in guider)
		{
			<li>
				<a class="kort__lank" href="@guide.Url()">
					<span class="kort__bild">
						@if (guide.Bild != null)
						{
							<img src="@guide.Bild.GetCropUrl(width: 600, height: 400)"
							     alt="@(guide.BildAltText ?? "")"
							     width="600" height="400" />
						}
					</span>
					<span class="kort__namn">@guide.Name</span>
				</a>
			</li>
		}
	</ul>
}
else
{
	<p>Inga bryggguider just nu.</p>
}