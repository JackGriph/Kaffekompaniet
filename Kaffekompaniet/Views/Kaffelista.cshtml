@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.Kaffelista>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "layout.cshtml";
	var kaffesorter = Model.Children().Where(x => x.IsVisible()).ToList();
}

<h1>@Model.Name</h1>
@Model.Brodtext

@if(kaffesorter.Any())
{
	<ul>
		@foreach(var kaffe in kaffesorter)
		{
			<li><a href="@kaffe.Url()">@kaffe.Name</a></li>
		}
	</ul>
}