    </bild>
    <bildAltText>
      <Value><![CDATA[Presskanna i glas fylld med nybryggt kaffe.]]></Value>
    </bildAltText>
    <brodtext>
      <Value><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EEn presskanna \u00E4r en glaskanna med en metallsil som du trycker ned. Kaffet f\u00E5r dra i vattnet i n\u00E5gra minuter och sedan pressar du ned silen s\u00E5 att sumpen stannar i botten. Det ger ett fylligt kaffe.\u003C/p\u003E"
}]]></Value>
    </brodtext>
    <kaffeGram>
      <Value><![CDATA[30]]></Value>
    </kaffeGram>
    <malningsgrad>
      <Value><![CDATA[[
  "Grov"
]]]></Value>
    </malningsgrad>
    <metaDescription>
      <Value><![CDATA[Brygg fylligt kaffe i presskanna med grovmalet kaffe, 94 °C vatten och fyra minuters väntan. Enkelt och perfekt till fikat.]]></Value>
    </metaDescription>
    <seoTitle>
      <Value><![CDATA[Så brygger du kaffe i presskanna]]></Value>
    </seoTitle>
    <steg>
      <Value><![CDATA[Värm vattnet till cirka 94 °C.
Mal 30 g kaffe grovt och lägg det i kannan.
Häll på 500 ml vatten och rör om försiktigt.
Lägg på locket utan att trycka ned och vänta 4 minuter.
Tryck långsamt ned pressen.
Häll upp allt direkt, så att kaffet inte blir beskt.]]></Value>
    </steg>
    <svarighetsgrad>
      <Value><![CDATA[[
  "L\u00E4tt"
]]]></Value>
    </svarighetsgrad>
    <temperatur>
      <Value><![CDATA[94]]></Value>
    </temperatur>
    <tid>
      <Value><![CDATA[4 minuter]]></Value>
    </tid>
