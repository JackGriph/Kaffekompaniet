    <bildAltText>
      <Value><![CDATA[En espressomaskin i ett hemmakök brygger espresso i en vit kopp]]></Value>
    </bildAltText>
    <brodtext>
      <Value><![CDATA[{
  "blocks": {
    "contentData": [],
    "settingsData": [],
    "expose": [],
    "layout": {}
  },
  "markup": "\u003Cp\u003EEspresso \u00E4r en liten, kraftig kopp kaffe. En espressomaskin pressar hett vatten under h\u00F6gt tryck genom finmalet kaffe p\u00E5 ungef\u00E4r 25 sekunder. Espresso \u00E4r ocks\u00E5 grunden i cappuccino och latte.\u003C/p\u003E"
}]]></Value>
    </brodtext>
    <kaffeGram>
      <Value><![CDATA[18]]></Value>
    </kaffeGram>
    <malningsgrad>
      <Value><![CDATA[[
  "Fin"
]]]></Value>
    </malningsgrad>
    <metaDescription>
      <Value><![CDATA[Lär dig brygga espresso med 18 g finmalet kaffe, jämnt tryck med tampern och 25–30 sekunders bryggtid.]]></Value>
    </metaDescription>
    <seoTitle>
      <Value><![CDATA[Så brygger du espresso hemma]]></Value>
    </seoTitle>
    <steg>
      <Value><![CDATA[Låt espressomaskinen bli ordentligt varm.
Mal 18 g kaffe fint.
Fördela kaffet jämnt i filterkorgen.
Packa kaffet med tampern med ett jämnt tryck.
Sätt i filterhållaren och starta bryggningen direkt.
Brygg cirka 36 ml på 25–30 sekunder och servera direkt.]]></Value>
    </steg>
    <svarighetsgrad>
      <Value><![CDATA[[
  "Sv\u00E5r"
]]]></Value>
    </svarighetsgrad>
    <temperatur>
      <Value><![CDATA[94]]></Value>
    </temperatur>
    <tid>
      <Value><![CDATA[25-30 sekunder]]></Value>
    </tid>
